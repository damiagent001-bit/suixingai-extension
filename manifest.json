{
  "manifest_version": 3,
  "name": "随心改｜HTML 可视化编辑器",
  "version": "0.9.0",
  "minimum_chrome_version": "114",
  "description": "直接编辑网页和本地 HTML，基础编辑与保存免费；登录开通月度会员，使用图片、更多字体与风格。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://suixingai.esecretary.cn/*"
  ],
  "action": {
    "default_title": "随心改 · 点击编辑当前页面",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "panel.css",
        "fonts/*",
        "icons/*.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}